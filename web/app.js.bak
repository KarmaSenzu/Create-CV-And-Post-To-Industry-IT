  } else if (jobId.includes('sigmatech-golang-banking-senior')) {
    pitchElem.value = `Halo Tim Rekrutmen PT Sigma Global Teknologi,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 / 4.00) dengan Sertifikasi Kompetensi Pengembang Perangkat Lunak dari BNSP. Berfokus pada perancangan arsitektur microservices Go (Golang), integrasi in-memory caching Redis, transaksi ACID database relasional PostgreSQL, dan orkestrasi kontainer Docker.\n\nPortofolio nyata:\n1. Golang-Finance — RESTful API transaksi finansial menerapkan Clean Architecture (Go, PostgreSQL, JWT, Docker Compose).\n2. Golang-Rekam — High-concurrency streaming platform berbasis Go Gin, gorilla/websocket in-memory hub, dan PostgreSQL 16.\n3. ServerMonitoring — Observabilitas Linux VPS real-time dan manajemen kontainer Docker.\n\nSaya siap bergabung segera (ASAP) dan memberikan dedikasi penuh untuk klien industri perbankan di PT Sigma Global Teknologi.`;
  } else if (jobId.includes('yakin-bertumbuh')) {
    pitchElem.value = `Halo Tim Rekrutmen PT Yakin Bertumbuh Sekuritas,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 / 4.00) dengan Sertifikasi Kompetensi Pengembang Perangkat Lunak (Program Analyst) dari BNSP. Memiliki spesialisasi dalam arsitektur backend Go (Golang), server real-time WebSockets berlatensi rendah, integrasi TCP socket, serta database PostgreSQL.\n\nPortofolio terverifikasi:\n1. Golang-Rekam — High-concurrency streaming platform dengan backend Go Gin, gorilla/websocket in-memory hub, sinkronisasi frame asinkron, dan PostgreSQL 16.\n2. Golang-Finance — RESTful API transaksi keuangan menerapkan Clean Architecture (Go, PostgreSQL, JWT, Docker Compose).\n3. ServerMonitoring — Command center observabilitas multi-server Linux berbasis Go dengan telemetri sistem real-time.\n\nSaya siap berkontribusi optimal sebagai Backend Golang Developer di PT Yakin Bertumbuh Sekuritas.`;
  } else if (jobId.includes('sumber-solusi')) {
    pitchElem.value = `Halo Tim Rekrutmen Sumber Solusi Hebat (Xignature),\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 / 4.00) dengan Sertifikasi Kompetensi Pengembang Perangkat Lunak (Program Analyst) dari BNSP. Menguasai arsitektur frontend modern Next.js/React, backend terstruktur Node.js/Go, otentikasi aman JWT/OAuth, dan database PostgreSQL.\n\nPortofolio nyata:\n1. Dmrxai — Platform aplikasi web interaktif berbasis Next.js 14, TypeScript, Tailwind CSS, dan Docker Compose.\n2. Mentari-Smart-Warehouse — Form produk pintar, manajemen inventaris, dan deployment server Linux VPS.\n3. Golang-Finance — RESTful API transaksi finansial menerapkan Clean Architecture (Go, PostgreSQL, Docker).\n\nSaya siap berkontribusi optimal sebagai Fullstack Engineer di Sumber Solusi Hebat.`;
  } else if (jobId.includes('stampindo')) {
    pitchElem.value = `Halo Tim Rekrutmen PT Stampindo Lancar Jaya (Stamps),\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85) dengan Sertifikasi Resmi PCAP (Programming Essentials in Python) serta Sertifikasi BNSP Analis Program. Menguasai arsitektur berorientasi objek (OOP), perancangan sistem berkinerja tinggi, RESTful API terstandarisasi, dan optimasi database PostgreSQL.\n\nPortofolio terverifikasi:\n1. Auto-Subtitle-AI — Backend pengolahan data multimedia asinkron berbasis Python, FastAPI, dan arsitektur OOP modular.\n2. Golang-Finance — RESTful API modular menerapkan Clean Architecture, database PostgreSQL, dan Docker Compose.\n3. ServerMonitoring — Platform pemantauan multi-server dan manajemen infrastruktur Linux.\n\nSiap berkontribusi aktif sebagai Junior Software Developer di Stamps.`;
  } else if (jobId.includes('berkatama')) {
    pitchElem.value = `Halo Tim Rekrutmen PT. Berkatama Sinergi Solusindo,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 / 4.00) dengan Sertifikasi Kompetensi Analis Program dari BNSP. Memiliki pemahaman mendalam mengenai administrasi sistem operasi Linux & Windows, optimasi database SQL (PostgreSQL & MySQL), perancangan RESTful API, dan troubleshooting sistem teknis.\n\nImplementasi nyata:\n1. ServerMonitoring — Command center observabilitas multi-host Linux, telemetri utilisasi hardware real-time, dan manajemen kontainer Docker.\n2. Golang-Finance — Arsitektur RESTful API keuangan menerapkan Clean Architecture dengan database relasional SQL.\n3. Mentari-Smart-Warehouse — Aplikasi web bisnis dan perancangan database terstruktur.\n\nSaya siap berkontribusi sigap sebagai Junior Software Engineer di PT. Berkatama Sinergi Solusindo.`;
  } else if (jobId.includes('truf')) {
    pitchElem.value = `Halo Tim Rekrutmen PT Truf Teknologi Indonesia,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85) dengan sertifikasi BNSP Analis Program. Menguasai perpaduan bahasa Go (Golang) untuk backend berlatensi rendah dan React.js untuk frontend interaktif.\n\nPortofolio nyata:\n1. Golang-Rekam — Sistem streaming video real-time dan manajemen metadata rekaman (Go Gin, WebSockets, React 18, PostgreSQL 16).\n2. Golang-Finance — RESTful API transaksi finansial menerapkan Clean Architecture (Go, PostgreSQL, Docker Compose).\n3. Dmrxai — Multi-model AI web platform berbasis modern stack (Next.js, TypeScript, Docker Compose).\n\nSaya siap berkontribusi optimal sebagai Software Engineer di PT Truf Teknologi Indonesia.`;
  } else if (jobId.includes('nusantara-sakti')) {
    pitchElem.value = `Halo Tim HRD & Rekrutmen Nusantara Sakti Group,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85) dengan sertifikasi BNSP Pengembang Perangkat Lunak. Menguasai pengembangan aplikasi web PHP (Laravel & CodeIgniter 4), desktop kasir/POS dengan Java OOP, dan database relasional MySQL.\n\nPortofolio nyata yang telah saya bangun:\n1. Laravel Travel — Portal reservasi tiket perjalanan (PHP Laravel & MySQL) mendigitalkan pemesanan dan jadwal manifest penumpang.\n2. Program Aplikasi Kasir Java — Aplikasi desktop POS berbasis Java OOP & MySQL untuk transaksi cepat, nota bukti bayar, dan pemotongan stok barang otomatis.\n3. CI4-Perpuspus-2 — Sistem informasi manajemen katalog dan sirkulasi buku perpustakaan berbasis PHP CodeIgniter 4.\n\nSaya siap berkontribusi langsung sebagai Programmer Junior di Nusantara Sakti Group.`;
  } else if (jobId.includes('syariah-bisnis')) {
    pitchElem.value = `Halo Tim Rekrutmen PT Syariah Bisnis Internasional,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 & BNSP Software Developer). Berfokus pada pengembangan antarmuka interaktif React.js, Next.js 14, TypeScript, dan integrasi backend RESTful API Node.js.\n\nProyek nyata yang telah saya selesaikan:\n1. Dmrxai — Platform asisten AI mandiri (Next.js 14, TypeScript, Docker Compose) untuk analisis dokumen teknis dan visualisasi data interaktif.\n2. Golang-Rekam — Antarmuka web pengawasan CCTV real-time berlatensi rendah (React 18, Vite, TypeScript, Zustand, WebSockets).\n3. AturJajan — Aplikasi mobile pencatatan finansial dan backend REST API Express.js & PostgreSQL dengan autentikasi JWT aman.\n\nSiap berkontribusi aktif mengembangkan produk digital di PT Syariah Bisnis Internasional.`;
  } else if (jobId.includes('skyshi')) {
    pitchElem.value = `Halo Tim Rekrutmen Skyshi Digital Indonesia,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 & BNSP Software Developer). Terbiasa memadukan frontend interaktif dengan backend terstruktur:\n1. Laravel Travel — Sistem web reservasi tiket travel (PHP Laravel MVC, Blade, & MySQL) dengan alur pembelian tiket terstruktur.\n2. Dmrxai — Platform web modern multi-kontainer (Next.js 14, TypeScript, Tailwind CSS, Docker Compose).\n3. Golang-Finance — RESTful API modular menerapkan Clean Architecture dan transaksi database relasional ACID.\n\nSiap berkontribusi dan beradaptasi cepat dalam ekosistem digital studio Skyshi Digital Indonesia.`;
  } else if (jobId.includes('gits') || job.category === '06-data-ai') {
    pitchElem.value = `Halo Tim Rekrutmen GITS Indonesia,\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 & BNSP). Berfokus pada data engineering, otomasi pipeline, dan keandalan database relasional:\n1. HERMES-PT.-ASISTEN-DMR — Pipeline pengumpulan dan transformasi data otomatis (Python ETL & Linux Cron) yang memfilter riset AI global ke Telegram.\n2. Auto-Subtitle-AI — Pipeline pengolahan data audio-ke-teks otomatis presisi tinggi berbasis model Faster-Whisper dan render FFmpeg.\n3. Golang-Finance — Perancangan skema relasional, optimasi query transaksi keuangan, dan penegakan integritas data ACID (PostgreSQL/MySQL).\n\nSiap berkontribusi pada pengembangan pipeline data di GITS Indonesia.`;
  } else if (job.category === '99-other' || (job.role && job.role.toLowerCase().includes('support'))) {
    pitchElem.value = `Halo Tim HRD & IT ${job.company || 'Perusahaan'},\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 & BNSP). Memiliki keahlian teruji dalam operasional dan dukungan teknis IT:\n1. ServerMonitoring — Command center observabilitas multi-host (Linux, SSH, Docker) memantau utilisasi CPU/RAM/Jaringan dan alerting insiden real-time.\n2. Perakitan Workstation & Setup Jaringan — Berpengalaman perakitan PC, instalasi sistem operasi ganda (Windows 10/11 & Ubuntu), crimping kabel LAN RJ45, dan setup WiFi kantor.\n3. Dukungan POS & Sistem Transaksi — Memahami arsitektur kasir (Aplikasi Kasir Java & Mentari Warehouse) serta penanganan backup database MySQL.\n\nSiap bertugas onsite dengan sigap, komunikatif, dan solutif mendukung kelancaran operasional IT perusahaan.`;
  } else {
    pitchElem.value = `Halo Tim Rekrutmen ${job.company || 'Perusahaan'},\n\nSaya Damar Fikrie, Sarjana Komputer (Cum Laude, IPK 3.85 & BNSP Software Developer). Memiliki portofolio kode teruji di GitHub (Clean Architecture REST API, aplikasi web interaktif, dan administrasi sistem Linux VPS). Siap berkontribusi maksimal untuk posisi ${job.role || 'Junior IT'}.`;
  }

  // Workflow Steps and Pipeline Tracker
  const step1Box = document.getElementById('step-1-box');
  const step2Box = document.getElementById('step-2-box');
  const btnStartApply = document.getElementById('btn-start-apply');
  const btnConfirmSubmitted = document.getElementById('btn-confirm-submitted');
  const skipBtn = document.getElementById('btn-skip-job');
  const stagePill = document.getElementById('detail-stage-pill');
  const stageSelect = document.getElementById('pipeline-stage-select');
  const notesInput = document.getElementById('pipeline-notes-input');

  stageSelect.value = job.status || 'pending_review';
  notesInput.value = job.notes || '';

  const stageLabels = {
    'pending_review': '⏳ Pending Review',
    'ready_to_submit': '🌐 Siap Submit di Portal',
    'applied': '📤 Terkirim (Applied)',
    'screening': '👀 Screening CV',
    'test_assigned': '💻 Tes Koding',
    'interview_hr': '🎙️ Interview HR',
    'interview_tech': '🧠 Interview Tech',
    'offered': '🎉 Offering Letter',
    'rejected': '❌ Ditolak',
    'ghosted': '👻 Ghosted',
    'skipped': 'Dilewati'
  };
  stagePill.textContent = stageLabels[job.status] || job.status;

  // Clear previous box classes
  step1Box.classList.remove('active-step', 'completed-step');
  step2Box.classList.remove('active-step', 'completed-step');

  if (job.status === 'pending_review') {
    step1Box.classList.add('active-step');
    btnStartApply.disabled = false;
    btnStartApply.innerHTML = `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg> 1. Buka Portal & Salin Pitch`;
    
    btnConfirmSubmitted.disabled = true;
    btnConfirmSubmitted.innerHTML = `2. Konfirmasi: Saya Sudah Submit`;
  } else if (job.status === 'ready_to_submit') {
    step1Box.classList.add('completed-step');
    btnStartApply.disabled = false;
    btnStartApply.innerHTML = `<span>✓</span> 1. Portal Dibuka (Buka Ulang)`;

    step2Box.classList.add('active-step');
    btnConfirmSubmitted.disabled = false;
    btnConfirmSubmitted.innerHTML = `<svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> 2. Konfirmasi: Saya Sudah Submit`;
  } else if (['applied', 'screening', 'test_assigned', 'interview_hr', 'interview_tech', 'offered', 'rejected', 'ghosted'].includes(job.status)) {
    step1Box.classList.add('completed-step');
    btnStartApply.disabled = false;
    btnStartApply.innerHTML = `<span>✓</span> Buka Halaman Portal`;

    step2Box.classList.add('completed-step');
    btnConfirmSubmitted.disabled = true;
    btnConfirmSubmitted.innerHTML = `<span>✓</span> Resmi Dilamar (${job.applied_date || 'Terkirim'})`;
  } else if (job.status === 'skipped') {
    btnStartApply.disabled = true;
    btnConfirmSubmitted.disabled = true;
  }

  if (job.status === 'skipped') {
    skipBtn.disabled = false;
    skipBtn.className = 'btn btn-secondary btn-block btn-sm';
    skipBtn.innerHTML = '🔄 Kembalikan ke Antrean (Un-skip)';
  } else {
    skipBtn.disabled = false;
    skipBtn.className = 'btn btn-danger-outline btn-block btn-sm';
    skipBtn.innerHTML = 'Lewati Lowongan Ini (Skip)';
  }
}

// 5. Setup Action Buttons (2-Step Workflow, Pipeline Update & Skip)
function setupActionButtons() {
  // Step 1: Open Portal & Copy Pitch
  document.getElementById('btn-start-apply').addEventListener('click', async () => {
    if (!state.activeJobId) return;
    const jobId = state.activeJobId;
    const job = state.jobs.find(j => j.job_id === jobId) || {};

    // Copy pitch note automatically to user clipboard
    const pitchText = document.getElementById('apply-card-pitch').value;
    try {
      await navigator.clipboard.writeText(pitchText);
    } catch (e) {
      console.warn('Clipboard write prevented:', e);
    }

    const res = await apiPost('/api/action', {
      action: 'start_apply',
      job_id: jobId
    });

    if (res && res.success) {
      showToast('🚀 Portal dibuka! Cover note & pitch tersalin ke clipboard.', 'success');
      if (res.job_url && res.job_url !== '#') {
        window.open(res.job_url, '_blank');
      }
      await loadAllData();
      selectJob(jobId);
    }
  });

  // Step 2: Confirm Submitted on External Portal
  document.getElementById('btn-confirm-submitted').addEventListener('click', async () => {
    if (!state.activeJobId) return;
    const jobId = state.activeJobId;
    const job = state.jobs.find(j => j.job_id === jobId) || {};

    const confirmed = confirm(
      `Verifikasi Pengiriman Lamaran:\n\n` +
      `Apakah Anda sudah mengunggah CV PDF dan menekan tombol Kirim/Submit di portal resmi ${job.company}?\n\n` +
      `Klik OK jika Anda sudah selesai submit di portal. Sistem akan mencatat tanggal lamaran resmi di tracker.csv dan audit_log.`
    );
    if (!confirmed) return;

    const res = await apiPost('/api/action', {
      action: 'confirm_submitted',
      job_id: jobId,
      notes: `Terkirim resmi oleh Damar Fikrie via portal ${job.company}`
    });

    if (res && res.success) {
      showToast(res.message, 'success');
      await loadAllData();
      selectJob(jobId);
    }
  });

  // Save Pipeline Stage Update & Recruiter Proof Notes
  document.getElementById('btn-save-stage').addEventListener('click', async () => {
    if (!state.activeJobId) return;
    const jobId = state.activeJobId;
    const stage = document.getElementById('pipeline-stage-select').value;
    const notes = document.getElementById('pipeline-notes-input').value;

    const res = await apiPost('/api/action', {
      action: 'update_stage',
      job_id: jobId,
      stage: stage,
      notes: notes
    });

    if (res && res.success) {
      showToast(res.message, 'success');
      await loadAllData();
      selectJob(jobId);
    }
  });

  // Skip / Un-skip Button
  document.getElementById('btn-skip-job').addEventListener('click', async () => {
    if (!state.activeJobId) return;
    const jobId = state.activeJobId;
    const job = state.jobs.find(j => j.job_id === jobId) || {};

    if (job.status === 'skipped') {
      const res = await apiPost('/api/action', {
        action: 'unskip',
        job_id: jobId
      });

      if (res && res.success) {
        showToast(res.message, 'success');
        await loadAllData();
        selectJob(jobId);
      }
    } else {
      const reason = prompt(`Masukkan alasan melewati lowongan '${job.role || jobId}' (opsional):`, 'Kurang sesuai fokus saat ini');
      if (reason === null) return;

      const res = await apiPost('/api/action', {
        action: 'skip',
        job_id: jobId,
        notes: reason
      });

      if (res && res.success) {
        showToast(res.message, 'info');
        await loadAllData();
        selectJob(jobId);
      }
    }
  });

  // Re-Render Button inside YAML Tab
  document.getElementById('btn-rerender-yaml').addEventListener('click', async () => {
    if (!state.activeJobId) return;
    const yamlContent = document.getElementById('detail-yaml-editor').value;
    showToast('Sedang me-render ulang CV via RenderCV...', 'info');

    const res = await apiPost('/api/action', {
      action: 'rerender',
      job_id: state.activeJobId,
      cv_yaml: yamlContent
    });

    if (res && res.success) {
      showToast(res.message, 'success');
      const pdfFrame = document.getElementById('detail-pdf-frame');
      pdfFrame.src = `${res.pdf_url}?t=${Date.now()}`;
    }
  });

  // Refresh PDF in detail
  document.getElementById('etab-pdf-refresh').addEventListener('click', () => {
    if (!state.activeJobDetail) return;
    const pdfFrame = document.getElementById('detail-pdf-frame');
    pdfFrame.src = `${state.activeJobDetail.pdf_url}?t=${Date.now()}`;
    showToast('Pratinjau PDF disegarkan', 'info');
  });

  // Copy PDF Full Path to Clipboard
  const btnCopyPath = document.getElementById('btn-copy-path');
  if (btnCopyPath) {
    btnCopyPath.addEventListener('click', async () => {
      const folderDisplay = document.getElementById('apply-card-folder-display');
      const pathText = folderDisplay ? (folderDisplay.getAttribute('data-full-path') || folderDisplay.textContent.trim()) : '';
      if (!pathText || pathText.startsWith('(')) {
        showToast('Path file belum tersedia.', 'warning');
        return;
      }
      try {
        await navigator.clipboard.writeText(pathText);
        showToast('📋 Path file PDF disalin ke clipboard!', 'success');
      } catch (err) {
        prompt('Salin path file ini:', pathText);
      }
    });
  }

  // Open Folder in Mac Finder (directly highlights PDF for drag & drop)
  const btnOpenFinder = document.getElementById('btn-open-finder');
  if (btnOpenFinder) {
    btnOpenFinder.addEventListener('click', async () => {
      if (!state.activeJobId) {
        showToast('Pilih lowongan terlebih dahulu.', 'warning');
        return;
      }
      const origHtml = btnOpenFinder.innerHTML;
      btnOpenFinder.disabled = true;
      btnOpenFinder.innerHTML = `<span>⏳</span> Membuka Finder...`;
      
      const res = await apiPost('/api/action', {
        action: 'open_folder',
        job_id: state.activeJobId
      });

      btnOpenFinder.disabled = false;
      btnOpenFinder.innerHTML = origHtml;

      if (res && res.success) {
        showToast('📂 Finder dibuka! File PDF CV langsung terseleksi & siap di-drag.', 'success');
      } else {
        showToast(res ? res.message : 'Gagal membuka Finder.', 'error');
      }
    });
  }
}

// 6. Setup Editorial Tabs Switching
function setupEditorialTabs() {
  const tabBtns = document.querySelectorAll('.e-tab-btn');
  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      tabBtns.forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.e-pane').forEach(p => p.classList.remove('active'));

      btn.classList.add('active');
      const targetPane = document.getElementById(btn.getAttribute('data-etab'));
      if (targetPane) targetPane.classList.add('active');
    });
  });
}

// 7. Setup Filters
function setupFilters() {
  const searchInput = document.getElementById('board-search');
  searchInput.addEventListener('input', (e) => {
    state.searchTerm = e.target.value;
    renderMasterJobList();
  });

  const catPills = document.querySelectorAll('.filter-pill');
  catPills.forEach(pill => {
    pill.addEventListener('click', () => {
      catPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      state.filterCategory = pill.getAttribute('data-cat');
      renderMasterJobList();
    });
  });

  const locSelect = document.getElementById('board-location-filter');
  locSelect.addEventListener('change', (e) => {
    state.filterLocation = e.target.value;
    renderMasterJobList();
  });

  const statusSelect = document.getElementById('board-status-filter');
  statusSelect.addEventListener('change', (e) => {
    state.filterStatus = e.target.value;
    renderMasterJobList();
  });

  // Header metric status click
  document.querySelectorAll('.h-metric[data-filter-status]').forEach(metric => {
    metric.addEventListener('click', () => {
      document.querySelectorAll('.h-metric[data-filter-status]').forEach(m => m.classList.remove('active'));
      metric.classList.add('active');

      state.filterStatus = metric.getAttribute('data-filter-status');
      statusSelect.value = state.filterStatus;
      document.querySelector('.nav-tab-btn[data-tab="tab-board"]').click();
      renderMasterJobList();
    });
  });
}

// 8. Setup Scraper Drawer Toggle
function setupScraperDrawer() {
  const toggleBtn = document.getElementById('btn-toggle-scraper');
  const closeBtn = document.getElementById('btn-close-scraper');
  const drawer = document.getElementById('quick-scraper-box');
  const form = document.getElementById('scanner-form');
  const term = document.getElementById('scanner-terminal');
  const termBody = document.getElementById('scanner-output');

  toggleBtn.addEventListener('click', () => {
    drawer.style.display = drawer.style.display === 'none' ? 'block' : 'none';
  });

  closeBtn.addEventListener('click', () => {
    drawer.style.display = 'none';
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const keyword = document.getElementById('scan-keyword').value;
    const location = document.getElementById('scan-location').value;
    const source = document.getElementById('scan-source').value;

    term.style.display = 'block';
    const time = new Date().toLocaleTimeString();
    termBody.innerHTML += `\n\n[${time}] Memulai pemindaian: '${keyword}' di '${location}'...`;
    termBody.innerHTML += `\n[${time}] Mengecek agregator: ${source}`;
    termBody.innerHTML += `\n[${time}] Mencegah duplikasi dengan tracker.csv...`;

    const res = await apiPost('/api/search', { keyword, location, source });
    if (res && res.success) {
      termBody.innerHTML += `\n[${time}] ${res.message}`;
      showToast(res.message, 'success');
      await loadLogs();
    }
  });
}

// 9. Load Verified Projects
async function loadProjects() {
  const projects = await apiGet('/api/projects');
  if (!projects) return;
  state.projects = projects;

  const container = document.getElementById('projects-container');
  container.innerHTML = '';

  projects.forEach(p => {
    const card = document.createElement('div');
    card.className = 'project-card glass-panel';

    const techTags = (p.tech || []).map(t => `<span class="tag-badge cyan">${escapeHtml(t)}</span>`).join('');
    const factsHtml = (p.facts || []).map(f => `<li><strong>${escapeHtml(f.aksi || '')}</strong>: ${escapeHtml(f.hasil || '')}</li>`).join('');

    card.innerHTML = `
      <div class="project-card-header">
        <h3 class="project-name">${escapeHtml(p.name)}</h3>
        <span class="project-role-badge">${escapeHtml(p.role || 'Developer')}</span>
      </div>
      <ul class="project-facts-list">${factsHtml}</ul>
      <div class="project-tech-tags">${techTags}</div>
    `;
    container.appendChild(card);
  });
}

// 10. Load Logs
async function loadLogs() {
  const logs = await apiGet('/api/logs');
  if (!logs) return;
  state.logs = logs;

  const tbody = document.getElementById('logs-tbody');
  tbody.innerHTML = '';

  logs.forEach(log => {
    const tr = document.createElement('tr');
    tr.innerHTML = `
      <td style="font-family: var(--font-mono); font-size: 11px; color: var(--text-dim);">${escapeHtml(log.timestamp)}</td>
      <td><code>${escapeHtml(log.job_id)}</code></td>
      <td><strong>${escapeHtml(log.company)}</strong></td>
      <td>${escapeHtml(log.role)}</td>
      <td><span class="tag-badge violet">${escapeHtml(log.event)}</span></td>
      <td><span class="tag-badge">${escapeHtml(log.channel)}</span></td>
      <td>${escapeHtml(log.detail)}</td>
      <td><span class="tag-badge emerald">${escapeHtml(log.next_action)}</span></td>
    `;
    tbody.appendChild(tr);
  });

  document.getElementById('btn-refresh-logs').addEventListener('click', async () => {
    await loadLogs();
    showToast('Log aktivitas disegarkan', 'info');
  });
}

// Setup Nav Tabs
function setupNavigation() {
  const tabs = document.querySelectorAll('.nav-tab-btn');
  tabs.forEach(tab => {
    tab.addEventListener('click', () => {
      tabs.forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.view-section').forEach(s => s.classList.remove('active'));

      tab.classList.add('active');
      const targetView = document.getElementById(tab.getAttribute('data-tab'));
      if (targetView) targetView.classList.add('active');
    });
  });
}

function escapeHtml(str) {
  if (!str) return '';
  return String(str)
    .replace(/&/g, '&amp;')
    .replace(/</g, '&lt;')
    .replace(/>/g, '&gt;')
    .replace(/"/g, '&quot;')
    .replace(/'/g, '&#039;');
}
